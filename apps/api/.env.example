# Copy to apps/api/.env and fill in. Loaded by pydantic-settings in dev.

# Pydantic AI model string: "<provider>:<model>".
MECHA_MODEL=anthropic:claude-sonnet-4-6
# MECHA_MODEL=openai:gpt-5.2

# Set the key matching the provider above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# SQLite conversation store, relative to apps/api (default: mecha.db).
# MECHA_DATABASE_PATH=mecha.db

# --- Tracing (all optional; nothing is exported unless a sink is set) -------

# Pick a sink: a Logfire token, an OTLP collector, or neither.
# LOGFIRE_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# MECHA_SERVICE_NAME=mecha-api
# MECHA_ENVIRONMENT=development
# Set to false to keep prompts and replies out of spans.
# MECHA_TRACE_CONTENT=true
# Print spans to the console too. Verbose; for debugging instrumentation.
# MECHA_TRACE_CONSOLE=false
# MECHA_LOG_LEVEL=INFO
