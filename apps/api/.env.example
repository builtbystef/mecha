# Copy to apps/api/.env and fill in. Loaded by pydantic-settings in dev.

# Pydantic AI model string: "<provider>:<model>".
MECHA_MODEL=anthropic:claude-sonnet-4-6
# MECHA_MODEL=openai:gpt-5.2

# Set the key matching the provider above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# SQLite conversation store, relative to apps/api (default: mecha.db).
# MECHA_DATABASE_PATH=mecha.db
